<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <solution>
    <add key="disableSourceControlIntegration" value="true" />
  </solution>
  <packageSources>
    <clear />
    <add key="nexus-proxy" value="https://repository.flexberry.org/repository/timepath-tmobis-nuget-group/index.json" protocolVersion="3" />
    <add key="nexus" value="https://repository.flexberry.org/repository/timepath-tmobis-nuget/index.json" protocolVersion="3" />
  </packageSources>

  <packageSourceMapping>
    <packageSource key="nexus-proxy">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
