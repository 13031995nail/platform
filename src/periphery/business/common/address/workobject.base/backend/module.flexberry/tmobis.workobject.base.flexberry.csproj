<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Tmobis.Business.Common.Address.WorkObject</RootNamespace>
    <PackageId>Tmobis.Business.Common.Address.WorkObject</PackageId>
    <Description>Flexberry бизнес-модуль сущности объектов работ.</Description>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\..\..\..\..\core\backend\module\tmobis.core.csproj" />
    <ProjectReference Include="..\..\..\..\..\core\backend\module.flexberry\tmobis.business.core.flexberry.csproj" />
    <ProjectReference Include="..\..\..\..\contacts\organization\backend\module\tmobis.organization\tmobis.business.common.contacts.organization.csproj" />
    <ProjectReference Include="..\..\..\..\personnel\placeofemployment\backend\module\tmobis.placeofemployment\tmobis.placeofemployment.csproj" />
    <ProjectReference Include="..\..\..\objectfunction\backend\module\tmobis.objectfunction\tmobis.objectfunction.csproj" />
    <ProjectReference Include="..\module\tmobis.workobject.base.csproj" />
    <ProjectReference Include="..\..\..\..\..\..\tech\fws\flexberry\tmobis.flexberry.web.odata\tmobis.flexberry.web.odata.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="sql/**/*.sql">
      <Pack>true</Pack>
      <PackageCopyToOutput>true</PackageCopyToOutput>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <!--Грязноватый хак, чтобы сэкономить место и не дублировать файлы контента
          ContentTargetFolders не помогает-->
      <PackagePath Condition=" '$(OS.StartsWith(`Windows`))' == 'true' ">contentFiles\any\net8.0\sql\</PackagePath>
      <PackagePath Condition=" '$(OS.StartsWith(`Windows`))' != 'true' ">contentFiles\any\net8.0\sql</PackagePath>
    </Content>
  </ItemGroup>

  <ItemGroup>
  </ItemGroup>

</Project>
