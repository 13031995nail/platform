{
  "name": "@tmobis/business-process-workshift",
  "version": "4.5.2",
  "author": "ООО \"Траектория времени\"",
  "description": "React бизнес-модуль сущности рабочих смен, задач смены и навигации по ним.",
  "scripts": {
    "build": "tsc",
    "generate:models": "openapi-generator-cli generate -i http://localhost:5000/swagger/v1/swagger.json -g typescript-axios -o src/models --additional-properties=withSeparateModelsAndApi=true,apiPackage=apis,modelPackage=. -t node_modules/@tmobis/core/oapi-gen --global-property models",
    "eslint": "eslint src/ --fix"
  },
  "devDependencies": {
    "@eslint/eslintrc": "catalog:",
    "@expo/vector-icons": "catalog:",
    "@gluestack-ui/core": "catalog:",
    "@openapitools/openapi-generator-cli": "catalog:",
    "@react-native-async-storage/async-storage": "catalog:",
    "@react-navigation/drawer": "catalog:",
    "@react-navigation/native": "catalog:",
    "@tailwindcss/postcss": "catalog:",
    "@tanstack/query-async-storage-persister": "catalog:",
    "@tanstack/react-query": "catalog:",
    "@tmobis/auth-keycloak": "workspace:*",
    "@tmobis/core": "workspace:*",
    "@tmobis/core-business": "workspace:*",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@types/uuid": "catalog:",
    "@typescript-eslint/eslint-plugin": "catalog:",
    "@typescript-eslint/parser": "catalog:",
    "babel-plugin-module-resolver": "catalog:",
    "dayjs": "catalog:",
    "eslint": "catalog:",
    "eslint-config-prettier": "catalog:",
    "eslint-import-resolver-typescript": "catalog:",
    "eslint-plugin-import": "catalog:",
    "eslint-plugin-prettier": "catalog:",
    "eslint-plugin-react": "catalog:",
    "eslint-plugin-react-hooks": "catalog:",
    "expo-constants": "catalog:",
    "expo-document-picker": "catalog:",
    "expo-file-system": "catalog:",
    "expo-router": "catalog:",
    "gluestack-ui": "catalog:",
    "i18next": "catalog:",
    "nativewind": "catalog:",
    "prettier": "catalog:",
    "react-hook-form": "catalog:",
    "react-i18next": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:"
  },
  "engines": {
    "node": ">=24"
  },
  "volta": {
    "node": "24.13.0",
    "yarn": "4.12.0"
  },
  "exports": {
    ".": "./src/index.ts",
    "./*": [
      "./src/*",
      "./src/*.ts",
      "./src/**/*.ts",
      "./src/*/index.ts"
    ]
  }
}
