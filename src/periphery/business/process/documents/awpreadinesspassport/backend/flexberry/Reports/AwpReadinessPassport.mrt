    <DataSources isList="true" count="2">
      <Act Ref="3" type="Stimulsoft.Report.Dictionary.StiPostgreSQLSource" isKey="true">
        <Alias>Act</Alias>
        <Columns isList="true" count="5">
          <value>datebegin,System.DateTime</value>
          <value>dateend,System.DateTime</value>
          <value>regdate,System.String</value>
          <value>actnumber,System.String</value>
          <value>organizationname,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>Act</Name>
        <NameInSource>Соединение</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>select
awp.datebegin, awp.dateend, 
TO_CHAR(ra.regdate, 'dd.MM.yyyy') as regdate, ra.actnumber,
act.organizationname
from awpreadinesspassport act
inner join awp on awp.primarykey = act.awp
inner join redinessact ra on ra.primarykey=act.readinessact
where act.primarykey = '{pk}'
</SqlCommand>
      </Act>
      <WorkObjects Ref="4" type="Stimulsoft.Report.Dictionary.StiPostgreSQLSource" isKey="true">
        <Alias>WorkObjects</Alias>
        <Columns isList="true" count="2">
          <value>number,System.Int32</value>
          <value>name,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>WorkObjects</Name>
        <NameInSource>Соединение</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>select r.number, w.name
from awpreadinesspassportobject r
inner join workobject w on w.primarykey =r.workobject 
where r.act ='{pk}'
order by r.number asc</SqlCommand>
      </WorkObjects>
    </DataSources>
