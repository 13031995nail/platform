<form class="ui {{appState.state}} flexberry-vertical-form form" role="form">
  {{#if (v-get validationObject "messages")}}
    <div class="field">
      {{flexberry-validationsummary errors=(v-get validationObject "messages")}}
    </div>
    <hr>
  {{/if}}
  <div class="ui stackable grid">
    <div class="two column row">
      <div class="column">
        <div class="new-white-panel">
          <div class="field m-0">
            {{tmobis-caption key="Номер акта" value=model.actNumber}}
          </div>
          {{#if model.regDate}}
            <div class="field m-0">
              {{tmobis-caption key="Дата оформления" value=(moment-format model.regDate "DD.MM.YYYY HH:mm")}}
            </div>
          {{/if}}
          {{#if model.actStatus}}
            <div class="field m-0">
              {{#tmobis-caption key="Статус"}}
                {{tmobis-badge label=model.actStatus.name}}
              {{/tmobis-caption}}
            </div>
          {{/if}}
          {{#if (or model.regDate model.actStatus model.actNumber)}}
            <hr>
          {{/if}}
          {{flexberry-lookup
            componentName="awpRedinessAct"
            label=(t "forms.rediness-act.awp-caption")
            value=model.awp
            displayAttributeName="name"
            relationName="awp"
            projection="AwpL"
            lookupLimitPredicate=actualityCustomLimitPredicate
            required=true
            readonly=isNotNewReadonly
            error=(v-get validationModel "awp" "message")
          }}
          {{flexberry-lookup
            componentName="awpAssessingProgramRedinessAct"
            label=(t "forms.rediness-act.awpAssessingProgram-caption")
            value=model.awpAssessingProgram
            displayAttributeName="actNumber"
            relationName="awpAssessingProgram"
            projection="AwpAssessingProgramL"
            lookupLimitPredicate=actualityCustomLimitPredicate
            required=true
            readonly=true
            error=(v-get validationModel "awpAssessingProgram" "message")
          }}
        </div>
      </div>
      <div class="column">
        <div class="new-white-panel">
          {{flexberry-lookup
            componentName="organizationRedinessAct"
            label=(t "forms.rediness-act.organization-caption")
            value=model.organization
            displayAttributeName="name"
            relationName="organization"
            projection="OrganizationName"
            lookupLimitPredicate=actualityCustomLimitPredicate
            required=true
            readonly=isNotNewReadonly
            error=(v-get validationModel "organization" "message")
          }}
          {{flexberry-field
            label=(t "forms.rediness-act.organizationAddress-caption")
            value=model.organizationAddress
            required=false
            readonly=true
          }}
          {{flexberry-lookup
            componentName="assigneeRedinessAct"
            label=(t "forms.rediness-act.assignee-caption")
            value=model.assignee
            displayAttributeName="fio"
            relationName="assignee"
            projection="EmployeeL"
            lookupLimitPredicate=assigneeCustomLimitPredicate
            required=true
            readonly=readonly
            error=(v-get validationModel "assignee" "message")
          }}
          {{flexberry-field
            label=(t "forms.rediness-act.partnerReadiness-caption")
            value=model.partnerReadiness
            dropdown=true
            items=(flexberry-enum "partner-readiness-level")
            required=false
            readonly=true
          }}
        </div>
      </div>
    </div>
    <div class="row">
      <div class="column">
        <div class="new-white-panel">
          {{#flexberry-toggler
            title=(t "forms.rediness-act.objects-caption")
            expandedCaption="свернуть"
            collapsedCaption="развернуть"
            expanded=true
            componentName="redinessActObjects"
          }}
            {{flexberry-groupedit
              componentName="objectsRedinessAct"
              buttonClass="armti-primary-btn"
              class="flexberry-groupedit"
              modelName="rediness-act-object"
              modelProjection=modelProjection.attributes.objects
              content=model.objects
              searchForContentChange=true
              readonly=readonly
              showCheckBoxInRow=true
              showDeleteButtonInRow=false
              showDeleteMenuItemInRow=false
              createNewButton=false
              deleteButton=false
              rowClickable=true
            }}
          {{/flexberry-toggler}}
        </div>
      </div>
    </div>
    <div class="row">
     <div class="column">
       <div class="new-white-panel">
         {{#flexberry-toggler
           title=(t "forms.rediness-act.signs-caption")
           expanded=true
           componentName="readinessActSigns"
         }}
            <label class="input-label">Для документа обязательными подписантами должны быть: Представитель проверяемой организации, Председатель комиссии ИЛИ Заместитель председателя комиссии и остальные члены комиссии. </label>
            <label class="input-label">Инициирует подписание Председатель комиссии муниципального образования, к которому принадлежит организация акта. Его роль - Контролирующий орган.</label>
            <hr>
           {{act-signing
             componentName="signersGroupEdit"
             groupEditClass="flexberry-groupedit"
             content=model.actSigns
             readonly=readonly
             hideAllButtons=(not updateEnabled)
             contentPropertyName="actSigns"
             stylusSigningIsAvailable=true
             rolesToAdd=rolesToAdd
             signModelName="readiness-act-sign"
             baseSignRole=baseSignRole
             refreshSigns=(action "refreshSigns")
           }}
         {{/flexberry-toggler}}
       </div>
     </div>
    </div>
  </div>
</form>