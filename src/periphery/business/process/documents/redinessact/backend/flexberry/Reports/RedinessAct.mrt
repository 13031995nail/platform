    <DataSources isList="true" count="4">
      <Act Ref="3" type="Stimulsoft.Report.Dictionary.StiPostgreSQLSource" isKey="true">
        <Alias>Act</Alias>
        <Columns isList="true" count="17">
          <value>regdate,System.DateTime</value>
          <value>actnumber,System.String</value>
          <value>organizationname,System.String</value>
          <value>organizationphone,System.String</value>
          <value>organizationaddress,System.String</value>
          <value>organization,System.Guid</value>
          <value>partnerreadiness,System.String</value>
          <value>datebegin,System.DateTime</value>
          <value>dateend,System.DateTime</value>
          <value>address,System.String</value>
          <value>resolutionnumber,System.String</value>
          <value>approveddate,System.DateTime</value>
          <value>chairperson,System.String</value>
          <value>orgname,System.String</value>
          <value>objectcount,System.Int64</value>
          <value>month_russian,System.String</value>
          <value>approveddate_month_russian,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>Act</Name>
        <NameInSource>Соединение</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>select act.*,
	awp.datebegin, awp.dateend, 
	org.address, org.name as orgname,
	pr.resolutionnumber, pr.approveddate,
	COALESCE(em.LastName || ' ', '') || COALESCE(em.firstname || ' ', '') || COALESCE(em.patronymic, '') as chairperson,
	(select count(1) from redinessactobject where act = act.primarykey) as objectcount,
	CASE EXTRACT(MONTH FROM act.regdate)::INT
        WHEN 1 THEN 'января'
        WHEN 2 THEN 'февраля'
        WHEN 3 THEN 'марта'
        WHEN 4 THEN 'апреля'
        WHEN 5 THEN 'мая'
        WHEN 6 THEN 'июня'
        WHEN 7 THEN 'июля'
        WHEN 8 THEN 'августа'
        WHEN 9 THEN 'сентября'
        WHEN 10 THEN 'октября'
        WHEN 11 THEN 'ноября'
        WHEN 12 THEN 'декабря'
    END AS month_russian,
CASE EXTRACT(MONTH FROM pr.approveddate)::INT
        WHEN 1 THEN 'января'
        WHEN 2 THEN 'февраля'
        WHEN 3 THEN 'марта'
        WHEN 4 THEN 'апреля'
        WHEN 5 THEN 'мая'
        WHEN 6 THEN 'июня'
        WHEN 7 THEN 'июля'
        WHEN 8 THEN 'августа'
        WHEN 9 THEN 'сентября'
        WHEN 10 THEN 'октября'
        WHEN 11 THEN 'ноября'
        WHEN 12 THEN 'декабря'
    END AS approveddate_month_russian
from redinessact act
inner join awp on awp.primarykey = act.awp
inner join awpassessingprogram pr on pr.primarykey=act.awpassessingprogram
left join organization org on org.primarykey=act.organization
left join employee em on em.primarykey=act.assignee
where act.primarykey = '{pk}'
</SqlCommand>
      </Act>
      <ProgramSchedule Ref="4" type="Stimulsoft.Report.Dictionary.StiPostgreSQLSource" isKey="true">
        <Alias>ProgramSchedule</Alias>
        <Columns isList="true" count="4">
          <value>startdate,System.DateTime</value>
          <value>finishdate,System.DateTime</value>
          <value>startdate_month_russian,System.String</value>
          <value>finishdate_month_russian,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>ProgramSchedule</Name>
        <NameInSource>Соединение</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>select startdate, CASE EXTRACT(MONTH FROM startdate)::INT
        WHEN 1 THEN 'января'
        WHEN 2 THEN 'февраля'
        WHEN 3 THEN 'марта'
        WHEN 4 THEN 'апреля'
        WHEN 5 THEN 'мая'
        WHEN 6 THEN 'июня'
        WHEN 7 THEN 'июля'
        WHEN 8 THEN 'августа'
        WHEN 9 THEN 'сентября'
        WHEN 10 THEN 'октября'
        WHEN 11 THEN 'ноября'
        WHEN 12 THEN 'декабря'
    END AS startdate_month_russian,
finishdate, CASE EXTRACT(MONTH FROM finishdate)::INT
        WHEN 1 THEN 'января'
        WHEN 2 THEN 'февраля'
        WHEN 3 THEN 'марта'
        WHEN 4 THEN 'апреля'
        WHEN 5 THEN 'мая'
        WHEN 6 THEN 'июня'
        WHEN 7 THEN 'июля'
        WHEN 8 THEN 'августа'
        WHEN 9 THEN 'сентября'
        WHEN 10 THEN 'октября'
        WHEN 11 THEN 'ноября'
        WHEN 12 THEN 'декабря'
    END AS finishdate_month_russian from (
	select min(startdate) startdate, max(finishdate) finishdate from awpassessingprogramevaluationschedule sc
inner join awpassessingprogram pr on pr.primarykey=sc.program
inner join redinessact act on act.awpassessingprogram =pr.primarykey 
where  act.primarykey = '{pk}') as r</SqlCommand>
      </ProgramSchedule>
      <WorkObjects Ref="5" type="Stimulsoft.Report.Dictionary.StiPostgreSQLSource" isKey="true">
        <Alias>WorkObjects</Alias>
        <Columns isList="true" count="3">
          <value>name,System.String</value>
          <value>objectreadiness,System.String</value>
          <value>number,System.Int32</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>WorkObjects</Name>
        <NameInSource>Соединение</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>select w.name, objectreadiness, r.number from redinessactobject r 
inner join workobject w on w.primarykey =r.workobject 
where r.act ='{pk}'
order by r.number</SqlCommand>
      </WorkObjects>
      <Signs Ref="6" type="Stimulsoft.Report.Dictionary.StiPostgreSQLSource" isKey="true">
        <Alias>Signs</Alias>
        <Columns isList="true" count="9">
          <value>signature,System.String</value>
          <value>fio,System.String</value>
          <value>signdate,System.DateTime</value>
          <value>rolename,System.String</value>
          <value>rolekey,System.Guid</value>
          <value>month_russian,System.String</value>
          <value>Data,System.String</value>
          <value>FileName,System.String</value>
          <value>FileExtId,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>Signs</Name>
        <NameInSource>Соединение</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>select sign.signature, r.name as rolename, sign.fio, sign.signdate, r.primarykey as rolekey,
	CASE EXTRACT(MONTH FROM sign.signdate)::INT
        WHEN 1 THEN 'января'
        WHEN 2 THEN 'февраля'
        WHEN 3 THEN 'марта'
        WHEN 4 THEN 'апреля'
        WHEN 5 THEN 'мая'
        WHEN 6 THEN 'июня'
        WHEN 7 THEN 'июля'
        WHEN 8 THEN 'августа'
        WHEN 9 THEN 'сентября'
        WHEN 10 THEN 'октября'
        WHEN 11 THEN 'ноября'
        WHEN 12 THEN 'декабря'
    END AS month_russian,
	f.Value AS "Data",
	f.Name AS "FileName",
	COALESCE(f.ExternalId, f.primaryKey) AS "FileExtId"
	from readinessactsign sign
inner join signrole r on r.primarykey=sign.signrole
LEFT JOIN "file" as f ON CAST(f.primaryKey AS VARCHAR(70)) = sign.Signature
where act = '{pk}'</SqlCommand>
      </Signs>
    </DataSources>
