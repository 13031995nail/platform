              <Components isList="true" count="1">
                <Image1 Ref="66" type="Image" isKey="true">
                  <AspectRatio>True</AspectRatio>
                  <Brush>Transparent</Brush>
                  <ClientRectangle>0,0,3.6,1</ClientRectangle>
                  <Conditions isList="true" count="0" />
                  <GetImageDataEvent> if (!string.IsNullOrEmpty(Signs.FileName) &amp;&amp; !string.IsNullOrEmpty(Signs.FileExtId.ToLower()))
 {
