<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Tmobis.Business.Process.Documents.Flexberry</RootNamespace>
    <PackageId>Tmobis.Business.Process.Documents.ActSign.Flexberry</PackageId>
    <IsPackable>true</IsPackable>
    <Description>Flexberry бизнес-модуль сущности подписей документов.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\..\..\core\backend\module.flexberry\tmobis.business.core.flexberry.csproj" />
    <ProjectReference Include="..\base\actsign.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="sql/**/*.sql">
      <Pack>true</Pack>
      <PackageCopyToOutput>true</PackageCopyToOutput>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <!--Грязноватый хак, чтобы сэкономить место и не дублировать файлы контента
          ContentTargetFolders не помогает-->
      <PackagePath Condition=" '$(OS.StartsWith(`Windows`))' == 'true' ">contentFiles\any\net8.0\sql\</PackagePath>
      <PackagePath Condition=" '$(OS.StartsWith(`Windows`))' != 'true' ">contentFiles\any\net8.0\sql</PackagePath>
    </Content>
  </ItemGroup>

</Project>
