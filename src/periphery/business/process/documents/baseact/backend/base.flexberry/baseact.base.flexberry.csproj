<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Tmobis.Business.Process.Documents.Base.Flexberry</RootNamespace>
    <PackageId>Tmobis.Business.Process.Documents.BaseAct.Base.Flexberry</PackageId>
    <Description>Flexberry бизнес-модуль базовой сущности актов.</Description>
    <IsPackable>true</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../base/baseact.base.csproj" />
    <ProjectReference Include="..\..\..\..\..\..\tech\fws\flexberry\tmobis.flexberry.autoincrement\Tmobis.Flexberry.Autoincrement.csproj" />
    <ProjectReference Include="..\..\..\..\..\core\backend\module.flexberry\tmobis.business.core.flexberry.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="sql/**/*.sql">
      <Pack>true</Pack>
      <PackageCopyToOutput>true</PackageCopyToOutput>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <!--Грязноватый хак, чтобы сэкономить место и не дублировать файлы контента
          ContentTargetFolders не помогает-->
      <PackagePath Condition=" '$(OS.StartsWith(`Windows`))' == 'true' ">contentFiles\any\net8.0\sql\</PackagePath>
      <PackagePath Condition=" '$(OS.StartsWith(`Windows`))' != 'true' ">contentFiles\any\net8.0\sql</PackagePath>
    </Content>
  </ItemGroup>
</Project>