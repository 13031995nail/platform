    <DataSources isList="true" count="4">
      <Header Ref="3" type="Stimulsoft.Report.Dictionary.StiPostgreSQLSource" isKey="true">
        <Alias>Header</Alias>
        <Columns isList="true" count="9">
          <value>program_id,System.Guid</value>
          <value>committee_id,System.Guid</value>
          <value>municipality_name,System.String</value>
          <value>ozp_year_begin,System.Int32</value>
          <value>ozp_year_end,System.Int32</value>
          <value>ozp_period,System.String</value>
          <value>datebegin_text,System.String</value>
          <value>dateend_text,System.String</value>
          <value>committee_workplaces_text,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>Header</Name>
        <NameInSource>Соединение</NameInSource>
        <Parameters isList="true" count="1">
          <value>pk,pk,27,0</value>
        </Parameters>
        <SqlCommand>-- 1) Header (общие поля документа)
WITH p AS (
SELECT
	ap.primarykey AS program_id,
	ap.awp,
	ap.organization,
	ap.committee,
	ap.organizationname,
	a.datebegin,
	a.dateend
	FROM awpassessingprogram ap
    JOIN awp a ON a.primarykey = ap.awp
    WHERE ap.primarykey = @pk
),
c AS (
SELECT
	p.*,
        COALESCE(
            p.committee,
            (
SELECT c2.primarykey
	FROM admissioncommittee c2
                WHERE c2.awp = p.awp
                  AND c2.organization = p.organization
                ORDER BY c2.edittime DESC NULLS LAST, c2.createtime DESC NULLS LAST
                LIMIT 1
            )
        ) AS committee_id
    FROM p
),
workplaces AS (
SELECT DISTINCT o.name AS place_name
	FROM c
    JOIN admissioncommitteeemployee ace ON ace.admissioncommittee = c.committee_id
    JOIN placeofemployment pe
      ON pe.employee = ace.employee
     AND COALESCE(pe.actuality, TRUE) = TRUE
    JOIN organization o ON o.primarykey = pe.organization
    WHERE o.name IS NOT NULL
)
SELECT
	c.program_id,
	c.committee_id,
	COALESCE(c.organizationname, o.name) AS municipality_name,
	EXTRACT(YEAR FROM c.datebegin)::int AS ozp_year_begin,
    EXTRACT(YEAR FROM c.dateend)::int AS ozp_year_end,
    CONCAT(EXTRACT(YEAR FROM c.datebegin)::int, '-', EXTRACT(YEAR FROM c.dateend)::int) AS ozp_period,
    to_char(c.datebegin, 'DD.MM.YYYY') AS datebegin_text,
    to_char(c.dateend, 'DD.MM.YYYY') AS dateend_text,
    (
SELECT string_agg(w.place_name, '; ' ORDER BY w.place_name)
        FROM workplaces w
    ) AS committee_workplaces_text
FROM c
LEFT JOIN organization o ON o.primarykey = c.organization;
</SqlCommand>
      </Header>
      <CommitteeWorkplaces Ref="4" type="Stimulsoft.Report.Dictionary.StiPostgreSQLSource" isKey="true">
        <Alias>CommitteeWorkplaces</Alias>
        <Columns isList="true" count="2">
          <value>place_no,System.Int64</value>
          <value>place_name,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>CommitteeWorkplaces</Name>
        <NameInSource>Соединение</NameInSource>
        <Parameters isList="true" count="1">
          <value>pk,pk,27,0</value>
        </Parameters>
        <SqlCommand>-- 2) Список уникальных мест работы членов комиссии (для пункта со списком мест работы)
WITH p AS (
SELECT
	ap.primarykey AS program_id,
	COALESCE(
	ap.committee,
	(
	SELECT c2.primarykey
                FROM admissioncommittee c2
                WHERE c2.awp = ap.awp
                  AND c2.organization = ap.organization
                ORDER BY c2.edittime DESC NULLS LAST, c2.createtime DESC NULLS LAST
                LIMIT 1
            )
        ) AS committee_id
    FROM awpassessingprogram ap
    WHERE ap.primarykey = @pk
),
poe AS (
SELECT DISTINCT o.name AS place_name
	FROM p
    JOIN admissioncommitteeemployee ace ON ace.admissioncommittee = p.committee_id
    JOIN placeofemployment pe
      ON pe.employee = ace.employee
     AND COALESCE(pe.actuality, TRUE) = TRUE
    JOIN organization o ON o.primarykey = pe.organization
    WHERE o.name IS NOT NULL
)
SELECT
	row_number() OVER (ORDER BY place_name) AS place_no,
    place_name
FROM poe
ORDER BY place_name;
</SqlCommand>
      </CommitteeWorkplaces>
      <App1 Ref="5" type="Stimulsoft.Report.Dictionary.StiPostgreSQLSource" isKey="true">
        <Alias>App1</Alias>
        <Columns isList="true" count="6">
          <value>nn,System.Int64</value>
          <value>object_function_name,System.String</value>
          <value>object_count,System.Int64</value>
          <value>period_text,System.String</value>
          <value>startdate,System.String</value>
          <value>finishdate,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>App1</Name>
        <NameInSource>Соединение</NameInSource>
        <Parameters isList="true" count="1">
          <value>pk,pk,27,0</value>
        </Parameters>
        <SqlCommand>WITH s AS (
SELECT
	sch.objectfunction AS object_function_pk,
	ofn.name AS object_function_name,
	sch.objectscount,
	sch.startdate,
	sch.finishdate
	FROM awpassessingprogramevaluationschedule sch
JOIN objectfunction ofn ON ofn.primarykey = sch.objectfunction
WHERE sch.program = @pk
),
g AS (
SELECT
	object_function_pk,
	object_function_name,
	MIN(COALESCE(LEAST(startdate, finishdate), startdate, finishdate)) AS startdate,
	MAX(COALESCE(GREATEST(startdate, finishdate), startdate, finishdate)) AS finishdate,
	SUM(objectscount) AS object_count_from_schedule
	FROM s
	GROUP BY object_function_pk, object_function_name
)
SELECT
	row_number() OVER (ORDER BY g.object_function_name) AS nn,
    g.object_function_name,
    g.object_count_from_schedule AS object_count,
    to_char(g.startdate, 'DD.MM.YYYY') || ' - ' || to_char(g.finishdate, 'DD.MM.YYYY') AS period_text,
    to_char(g.startdate, 'DD.MM.YYYY') AS startdate,
    to_char(g.finishdate, 'DD.MM.YYYY') AS finishdate
FROM g
ORDER BY g.object_function_name;
</SqlCommand>
      </App1>
      <App2 Ref="6" type="Stimulsoft.Report.Dictionary.StiPostgreSQLSource" isKey="true">
        <Alias>App2</Alias>
        <Columns isList="true" count="4">
          <value>nn,System.Int64</value>
          <value>object_function_name,System.String</value>
          <value>organization_name,System.String</value>
          <value>workobject_name,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>App2</Name>
        <NameInSource>Соединение</NameInSource>
        <Parameters isList="true" count="1">
          <value>pk,pk,27,0</value>
        </Parameters>
        <SqlCommand>-- App2: перечень объектов программы (для GroupHeader: object_function_name -&gt; organization_name)
WITH base AS (
SELECT DISTINCT
	COALESCE(NULLIF(BTRIM(ofn.name), ''), 'Без назначения')        AS object_function_name,
	COALESCE(NULLIF(BTRIM(org.name), ''), 'Без организации')       AS organization_name,
	COALESCE(NULLIF(BTRIM(wo.name), ''),  'Без наименования объекта') AS workobject_name,
	wo.primarykey AS workobject_pk
	from awpassessingprogram a 
	join awpassessingprogramevaluationschedule apes on apes.program=a.primarykey
    JOIN workobject wo ON wo.objectfunction = apes.objectfunction
    JOIN organization org ON org.primarykey = wo.organization and (org.primarykey = a.organization or org.hierarchy is not null and org.hierarchy = a.organization)
    LEFT JOIN objectfunction ofn ON ofn.primarykey = wo.objectfunction
    WHERE apes.program = @pk
      AND COALESCE(wo.actuality, TRUE) = TRUE
)
SELECT
	ROW_NUMBER() OVER (
        ORDER BY object_function_name, organization_name, workobject_name, workobject_pk
    ) AS nn,
    object_function_name,
    organization_name,
    workobject_name
FROM base
ORDER BY object_function_name, organization_name, workobject_name, workobject_pk;</SqlCommand>
      </App2>
    </DataSources>
