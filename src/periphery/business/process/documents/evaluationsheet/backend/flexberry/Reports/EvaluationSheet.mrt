      <ИсточникДанных1 Ref="3" type="Stimulsoft.Report.Dictionary.StiPostgreSQLSource" isKey="true">
        <Alias>ИсточникДанных1</Alias>
        <Columns isList="true" count="6">
          <value>evaluation_sheet_id,System.Guid</value>
          <value>partner_type_id,System.Guid</value>
          <value>document_title,System.String</value>
          <value>readiness_index,System.Decimal</value>
          <value>has_bh_objects,System.Boolean</value>
          <value>bh_break_comment,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>ИсточникДанных1</Name>
        <NameInSource>Соединение</NameInSource>
        <Parameters isList="true" count="1">
          <value>pk,pk,27,0</value>
        </Parameters>
        <SqlCommand>WITH doc AS (
SELECT
	es.primarykey AS evaluation_sheet_id,
	es.objectreadinessindex AS readiness_index,
	COALESCE(es.ownerlessobjects, false) AS has_bh_objects,
	ot.primarykey AS partner_type_id
	FROM evaluationsheet es
    JOIN organization o ON o.primarykey = es.organization
    JOIN organizationtype ot ON ot.primarykey = o.organizationtype
    WHERE es.primarykey = @pk
)
SELECT
	d.evaluation_sheet_id,
	d.partner_type_id,
	CASE d.partner_type_id
        WHEN '7909c321-f77c-4bdf-9d4d-e618fac50c81'::uuid THEN
            'ОЦЕНОЧНЫЙ ЛИСТ ДЛЯ РАСЧЕТА ИНДЕКСА ГОТОВНОСТИ К ОТОПИТЕЛЬНОМУ ПЕРИОДУ МУНИЦИПАЛЬНОГО ОБРАЗОВАНИЯ'
        WHEN '44cf13f0-5b06-4509-a11d-1c05c9c39e80'::uuid THEN
            'ОЦЕНОЧНЫЙ ЛИСТ ДЛЯ РАСЧЕТА ИНДЕКСА ГОТОВНОСТИ К ОТОПИТЕЛЬНОМУ ПЕРИОДУ ТЕПЛОСНАБЖАЮЩИХ, ТЕПЛОСЕТЕВЫХ ОРГАНИЗАЦИЙ'
        WHEN '3859980c-562d-4ef3-b716-e3dc72dc6bbe'::uuid THEN
            'ОЦЕНОЧНЫЙ ЛИСТ ДЛЯ РАСЧЕТА ИНДЕКСА ГОТОВНОСТИ К ОТОПИТЕЛЬНОМУ ПЕРИОДУ ВЛАДЕЛЬЦЕВ ТЕПЛОВЫХ СЕТЕЙ, НЕ ЯВЛЯЮЩИХСЯ ТЕПЛОСЕТЕВЫМИ ОРГАНИЗАЦИЯМИ'
        WHEN '1fb68a1f-7533-4822-a312-29d978168327'::uuid THEN
            'ОЦЕНОЧНЫЙ ЛИСТ ДЛЯ РАСЧЕТА ИНДЕКСА ГОТОВНОСТИ К ОТОПИТЕЛЬНОМУ ПЕРИОДУ ПОТРЕБИТЕЛЕЙ ТЕПЛОВОЙ ЭНЕРГИИ'
        ELSE
            'ОЦЕНОЧНЫЙ ЛИСТ'
    END AS document_title,
    d.readiness_index,
    d.has_bh_objects,
    CASE
        WHEN d.partner_type_id = '7909c321-f77c-4bdf-9d4d-e618fac50c81'::uuid
         AND d.has_bh_objects
        THEN 'Приложение к оценочному листу для расчета индекса готовности к отопительному периоду муниципального образования в случае наличия у них бесхозяйных объектов теплоснабжения, которым не определена организация, осуществляющая их содержание и обслуживание'
        ELSE NULL
    END AS bh_break_comment
FROM doc d;</SqlCommand>
      </ИсточникДанных1>
      <ИсточникДанных3 Ref="4" type="Stimulsoft.Report.Dictionary.StiPostgreSQLSource" isKey="true">
        <Alias>ИсточникДанных3</Alias>
        <Columns isList="true" count="11">
          <value>requirement_id,System.Guid</value>
          <value>reqorder,System.Int32</value>
          <value>reqnumber,System.String</value>
          <value>shortreqname,System.String</value>
          <value>supportingdocname,System.String</value>
          <value>indicatorname,System.String</value>
          <value>calculatedreq,System.Decimal</value>
          <value>problemcomment,System.String</value>
          <value>deadline,System.DateTime</value>
          <value>deadline_text,System.String</value>
          <value>sort_key,System.Int32</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>ИсточникДанных3</Name>
        <NameInSource>Соединение</NameInSource>
        <Parameters isList="true" count="1">
          <value>pk,pk,27,0</value>
        </Parameters>
        <SqlCommand>SELECT
	r.primarykey AS requirement_id,
	r.reqorder,
	r.reqnumber,
	r.shortreqname,
	r.supportingdocname,
	r.indicatorname,
	r.calculatedreq,
	r.problemcomment,
	r.deadline,
	to_char(r.deadline + interval '5 hour', 'DD.MM.YYYY HH24:MI') AS deadline_text,
	r.sortorder AS sort_key
	FROM evaluationsheetrequirement r
JOIN evaluationsheet es
    ON es.primarykey = r.evaluationsheet
JOIN organization o
    ON o.primarykey = es.organization
JOIN organizationtype ot
    ON ot.primarykey = o.organizationtype
LEFT JOIN verificationrequierement vr
    ON vr.primarykey = r.verificationrequirement
WHERE r.evaluationsheet = @pk
  AND (
        ot.primarykey &lt;&gt; '7909c321-f77c-4bdf-9d4d-e618fac50c81'::uuid
        OR COALESCE(vr.ownerlessobjects, false) = true
      )
ORDER BY
    r.sortorder,
    r.reqorder NULLS LAST,
    r.primarykey;
</SqlCommand>
      </ИсточникДанных3>
      <ИсточникДанных4 Ref="5" type="Stimulsoft.Report.Dictionary.StiPostgreSQLSource" isKey="true">
        <Alias>ИсточникДанных4</Alias>
        <Columns isList="true" count="11">
          <value>requirement_id,System.Guid</value>
          <value>reqorder,System.Int32</value>
          <value>reqnumber,System.String</value>
          <value>shortreqname,System.String</value>
          <value>supportingdocname,System.String</value>
          <value>indicatorname,System.String</value>
          <value>calculatedreq,System.Decimal</value>
          <value>problemcomment,System.String</value>
          <value>deadline,System.DateTime</value>
          <value>deadline_text,System.String</value>
          <value>sort_key,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>ИсточникДанных4</Name>
        <NameInSource>Соединение</NameInSource>
        <Parameters isList="true" count="1">
          <value>pk,pk,27,0</value>
        </Parameters>
        <SqlCommand>WITH src AS (
SELECT
	r.primarykey,
	r.reqorder,
	r.sortorder,
	r.reqnumber,
	r.shortreqname,
	r.supportingdocname,
	r.indicatorname,
	r.calculatedreq,
	r.problemcomment,
	r.deadline,
	NULLIF(
	trim(both '.' from regexp_replace(coalesce(r.reqnumber, ''), '[^0-9.]', '', 'g')),
            ''
        ) AS req_norm
    FROM evaluationsheetrequirement r
    JOIN evaluationsheet es
        ON es.primarykey = r.evaluationsheet
    JOIN organization o
        ON o.primarykey = es.organization
    JOIN organizationtype ot
        ON ot.primarykey = o.organizationtype
    JOIN verificationrequierement vr
        ON vr.primarykey = r.verificationrequirement
    WHERE r.evaluationsheet = @pk
      AND ot.primarykey = '7909c321-f77c-4bdf-9d4d-e618fac50c81'::uuid
      AND COALESCE(es.ownerlessobjects, false) = true
      AND COALESCE(vr.ownerlessobjects, false) = false
      AND COALESCE(vr.code, '') &lt;&gt; '0'
),
x AS (
SELECT
	s.*,
        CASE
            WHEN s.req_norm ~ '^[0-9]+([.][0-9]+)*$'
            THEN string_to_array(s.req_norm, '.')::int[]
            ELSE NULL
        END AS req_path
    FROM src s
)
SELECT
	x.primarykey AS requirement_id,
	x.reqorder,
	x.reqnumber,
	x.shortreqname,
	x.supportingdocname,
	x.indicatorname,
	x.calculatedreq,
	x.problemcomment,
	x.deadline,
	to_char(x.deadline + interval '5 hour', 'DD.MM.YYYY HH24:MI') AS deadline_text,
	array_to_string(
	ARRAY(
	SELECT lpad(u.n::text, 5, '0')
            FROM unnest(x.req_path) WITH ORDINALITY AS u(n, ord)
            ORDER BY u.ord
        ),
        '.'
    ) AS sort_key
FROM x
WHERE x.req_path IS NOT NULL
ORDER BY
    sort_key,
    x.reqorder NULLS LAST,
    x.sortorder,
    x.primarykey;
</SqlCommand>
      </ИсточникДанных4>
