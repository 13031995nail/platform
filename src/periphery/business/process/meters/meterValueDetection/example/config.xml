<?xml version='1.0' encoding='utf-8'?>
<widget id="ru.tmobis.meterdetection.example" version="1.0.0" xmlns="http://www.w3.org/ns/widgets" xmlns:cdv="http://cordova.apache.org/ns/1.0">
    <name>Распознавание показаний</name>
    <description>Пример модуля meterValueDetection: фронт (Ember-аддон) + мобилка (Cordova YOLO-плагин)</description>
    <author email="" href="">ООО "Траектория времени"</author>
    <content src="index.html" />
    <access origin="*" />
    <allow-intent href="http://*/*" />
    <allow-intent href="https://*/*" />
    <preference name="Fullscreen" value="false" />
    <preference name="loadUrlTimeoutValue" value="60000" />
    <platform name="android">
        <preference name="AndroidXEnabled" value="true" />
        <preference name="android-minSdkVersion" value="22" />
        <preference name="android-compileSdkVersion" value="33" />
        <preference name="android-targetSdkVersion" value="33" />
    </platform>
    <plugin name="tmobis-cordova-camera-preview" spec="../camera-preview" />
    <plugin name="tmobis-cordova-meter-value-detection" spec="../mobile" />
</widget>
