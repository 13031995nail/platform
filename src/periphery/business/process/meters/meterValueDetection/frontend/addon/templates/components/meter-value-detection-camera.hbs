{{!-- Кнопка открытия камеры / предпросмотр снимка --}}
{{#if capturedImage}}
  <div class="rate-photos-preview">
    <img id="ratePhoto" class="rate-data-img" src="{{capturedImage}}" crossorigin="anonymous">

    <div class="rate-photos-result">
      <div class="rate-photos-value">
        {{#if recognizedValue}}
          Распознано: <b>{{recognizedValue}}</b>
          {{#if recognitionConfidence}}<span class="rate-photos-confidence">({{recognitionConfidence}}%)</span>{{/if}}
        {{else}}
          Значение не распознано
        {{/if}}
      </div>

      {{#unless readonly}}
        <button type="button" class="md-btn" disabled={{isDetecting}} onclick={{action "detectFromPhoto"}}>
          {{if isDetecting "Распознавание…" "Распознать по фото"}}
        </button>
        <button type="button" class="md-btn secondary" onclick={{action "openCamera"}}>
          Переснять
        </button>
      {{/unless}}
    </div>
  </div>
{{else}}
  {{#unless readonly}}
    <div class="rate-photos-actions">
      <button type="button" class="md-btn" onclick={{action "openCamera"}}>
        {{buttonCaption}}
      </button>
    </div>
  {{/unless}}
{{/if}}

{{!-- Полноэкранный оверлей камеры --}}
{{#if showCamera}}
  <div class="camera-fullscreen-overlay">
    <div class="camera-overlay-background"></div>

    <div class="camera-target-frame">
      <div class="target-frame-inner"></div>
    </div>

    <div class="camera-controls-panel">
      <div class="live-ocr-display">
        {{#if liveValue}}
          <div class="live-value-block {{liveValueClass}}">
            <span class="live-number">{{liveValue}}</span>
            <span class="live-confidence">{{liveConfidence}}%</span>
          </div>
        {{else}}
          <div class="live-value-placeholder">
            {{#if isLiveDetecting}}
              Распознавание…
            {{else}}
              Наведите камеру на счётчик
            {{/if}}
          </div>
        {{/if}}
      </div>

      <div class="camera-controls-container">
        <button
          type="button"
          class="camera-control-btn flash-btn {{if cameraFlashOn 'active'}}"
          onclick={{action "toggleFlash"}}
          title="{{if cameraFlashOn 'Выключить вспышку' 'Включить вспышку'}}"
        >
          <svg class="md-icon" width="30" height="30" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 2v11h3v9l7-12h-4l4-8z"/></svg>
          <span class="btn-label">{{if cameraFlashOn 'Выкл.' 'Вкл.'}}</span>
        </button>

        <button
          type="button"
          class="camera-control-btn capture-btn"
          onclick={{action "takePicture"}}
          title="Сделать снимок"
        >
          <svg class="md-icon" width="34" height="34" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 15.2a3.2 3.2 0 1 0 0-6.4 3.2 3.2 0 0 0 0 6.4zM9 2 7.17 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2h-3.17L15 2H9zm3 15c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5z"/></svg>
          <span class="btn-label">Фото</span>
        </button>

        <button
          type="button"
          class="camera-control-btn close-btn"
          onclick={{action "closeCamera"}}
          title="Закрыть камеру"
        >
          <svg class="md-icon" width="30" height="30" viewBox="0 0 24 24" aria-hidden="true"><path d="M18.3 5.71a1 1 0 0 0-1.41 0L12 10.59 7.11 5.7A1 1 0 1 0 5.7 7.11L10.59 12 5.7 16.89a1 1 0 1 0 1.41 1.41L12 13.41l4.89 4.89a1 1 0 0 0 1.41-1.41L13.41 12l4.89-4.89a1 1 0 0 0 0-1.4z"/></svg>
          <span class="btn-label">Закрыть</span>
        </button>
      </div>
    </div>
  </div>
{{/if}}
