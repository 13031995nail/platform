{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "S3": {
    "ServiceUrl": "https://stands.timepath.ru:8333",
    "AuthenticationRegion": "us-east-1",
    "BucketName": "tmobis-s3-sample",
    "AccessKey": "CHANGE_ME",
    "SecretKey": "CHANGE_ME",
    "KeyPrefix": "tmobis/sample",
    "ForcePathStyle": true,
    "AllowInsecureHttp": false,
    "UseChunkEncoding": false,
    "PresignedUrlLifetimeMinutes": 15,
    "TimeoutSeconds": 100,
    "MaxErrorRetry": 3
  },
  "S3Sample": {
    "FileName": "tmobis-s3-sample.txt",
    "Payload": "Tmobis S3 sample payload."
  }
}
