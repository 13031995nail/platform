{{#if loading}}
  <p>Loading dashboard...</p>
{{else if error}}
  <div class="error">{{error}}</div>
{{else if dashboardUrl}}
  <iframe 
    src={{dashboardUrl}} 
    frameborder="0" 
    width="100%" 
    height="800"
    class="tmobis-dashboard-frame"
    allowtransparency
  ></iframe>
{{else}}
  <p>No dashboard configured</p>
{{/if}}