{
  "name": "@timepath/tmobis-platform",
  "version": "4.5.2",
  "description": "Монорепозиторий Платформы Т-Мобис",
  "private": true,
  "author": "ООО 'Траектория времени'",
  "repository": "",
  "engines": {
    "node": ">= 24.0.0"
  },
  "publishConfig": {
    "@timepath:registry": "https://repository.flexberry.org/repository/timepath-tmobis-npm/",
    "@tmobis:registry": "https://repository.flexberry.org/repository/timepath-tmobis-npm/"
  },
  "volta": {
    "node": "24.13.0",
    "yarn": "4.12.0"
  },
  "workspaces": {
    "packages": [
      "src/tools/*",
      "src/tools/**/*",
      "src/core/react",
      "src/periphery/**/react",
      "src/periphery/**/react/*",
      "src/periphery/tech/notifications/front/websocket",
      "src/templates/expo-app",
      "!src/periphery/business/process/meters/meterValueDetection/example",
      "!src/periphery/business/process/meters/meterValueDetection/example/**"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^20.3.1",
    "@commitlint/config-conventional": "^20.3.1",
    "@commitlint/types": "^20.3.1",
    "@react-native/assets-registry": "^0.79.3",
    "@types/react-native": "0.72.8",
    "autoprefixer": "^10.4.21",
    "commitizen": "^4.3.1",
    "conventional-changelog": "^7.1.1",
    "conventional-changelog-conventionalcommits": "^9.1.0",
    "conventional-changelog-tmobis": "workspace:*",
    "cz-conventional-changelog": "^3.3.0",
    "husky": "^9.1.7",
    "lerna": "^8.1.9",
    "lodash-es": "^4.17.23",
    "postcss": "^8.5.4",
    "tailwindcss": "^3.4.17"
  },
  "scripts": {
    "prepare": "husky",
    "changelog": "conventional-changelog -p tmobis",
    "version": "yarn changelog && git add CHANGELOG.md",
    "publish-minor": "yarn lerna publish minor",
    "publish-patch": "yarn lerna publish patch",
    "version-minor": "yarn lerna version minor",
    "version-patch": "yarn lerna version patch"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "overrides": {
    "lightningcss": "1.30.1"
  },
  "resolutions": {
    "lightningcss": "1.30.1"
  }
}
