    <PackageVersion Include="JUnitTestLogger" Version="1.1.0" />
    <PackageVersion Include="log4net" Version="3.2.0" />
    <PackageVersion Include="log4net.LokiAppender" Version="1.0.5" />
    <PackageVersion Include="MailKit" Version="4.13.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.Negotiate" Version="10.0.2" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Core" Version="2.3.9" />
