<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <VersionPrefix>4.5.2</VersionPrefix>
    <RuntimeIdentifiers>win-x64;linux-x64</RuntimeIdentifiers>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <DisableImplicitNuGetFallbackFolder>true</DisableImplicitNuGetFallbackFolder>
  </PropertyGroup>
  <PropertyGroup Condition="'$(CICDPackageVersion)' != ''">
    <VersionSuffix>$(CICDPackageVersion)</VersionSuffix>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="AWSSDK.S3" Version="4.0.21.1" />
    <PackageVersion Include="CoreWCF.ConfigurationManager" Version="1.8.0" />
